{
  "schema_version": 1,
  "limits": {
    "max_components": 4,
    "max_requests": 100,
    "max_download_bytes": 20971520,
    "max_response_bytes": 8388608,
    "max_seconds": 240,
    "request_interval_seconds": 1.0,
    "metadata_ttl_seconds": 21600,
    "max_files": 300,
    "max_file_bytes": 524288,
    "max_source_bytes": 12582912,
    "cache_max_bytes": 134217728
  },
  "sources": [
